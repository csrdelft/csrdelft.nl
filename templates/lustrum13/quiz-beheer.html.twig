<!doctype html>
<html lang="nl"><head><meta charset="utf-8"><meta name="robots" content="noindex, nofollow, noarchive"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Dagvragen beheren · Panorama</title>{{ csrfMetaTag() }}{{ css_asset('panorama-spellen') }}</head>
<body class="arcade-page"><header class="arcade-header"><a href="/panorama/spellen">← Spellen</a><span class="arcade-brand">Dagvragen</span><a href="/panorama/spellen/spelbeheer">Spelbeheer</a></header>
<main class="quiz-admin" data-quiz-admin><section><h1>Dagvragen</h1><button type="button" class="outline-button" data-new-question>Nieuwe vraag</button><div data-question-list></div></section>
<form data-question-form enctype="multipart/form-data"><input type="hidden" name="id" value="0"><input type="hidden" name="revision" value="0"><fieldset data-question-fields><label>Datum<input type="date" name="day" required></label><label>Vraag<input name="prompt" required maxlength="180" value="Welke stad zie je?"></label><label>Geaccepteerde antwoorden<textarea name="answers" rows="4" required maxlength="2000" placeholder="Parijs&#10;Paris"></textarea><small>Eén variant per regel. Kleine spelfouten worden automatisch herkend.</small></label><label>Afbeelding<input type="file" name="photo" accept="image/jpeg,image/png,image/webp"></label><img data-question-preview hidden alt="Voorbeeld van de vraag"><label class="check-label"><input type="checkbox" name="removeImage" value="1">Afbeelding verwijderen</label><label>Fotocredit<input name="credit" maxlength="255" placeholder="Fotograaf / bron"></label><label class="check-label"><input type="checkbox" name="published" value="1" checked>Zichtbaar op de gekozen dag</label><button class="play-button" type="submit">Opslaan</button></fieldset><p data-admin-message role="status"></p></form><form data-daily-visibility style="grid-column:1/-1;border-top:1px solid #a7b09a;padding-top:24px"><h2>Zichtbare cijfers</h2><label class="check-label"><input type="checkbox" name="showParticipants" value="1">Aantal deelnemers tonen</label><label class="check-label"><input type="checkbox" name="showFirstTry" value="1">Aantal in één keer goed tonen</label><button type="submit" class="outline-button">Weergave opslaan</button><p role="status"></p></form></main>
<div class="arcade-notice" role="status" aria-live="polite" hidden></div>{{ js_asset('panorama-spellen') }}</body></html>
