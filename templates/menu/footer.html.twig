<footer class="footer mt-auto py-3">
	<div class="container-fluid p-md-5">
		<div class="row">
			{% set menu = get_menu('main') %}
			{% for item in menu.children %}
				{% if is_granted('bekijken', item) %}
					<div class="col-6 col-md">
						<h5>{{ item.tekst }}</h5>
						<ul class="list-unstyled text-small">
							{% for subItem in item.children %}
								{% if is_granted('bekijken', subItem) %}
									<li><a class="link-secondary" href="{{ subItem.link }}">{{ subItem.tekst | raw }}</a></li>
								{% endif %}
							{% endfor %}
						</ul>
					</div>
				{% endif %}
			{% endfor %}
		</div>

		<hr class="my-4">

		<div class="copyright footer-inner d-flex justify-content-between align-items-center flex-wrap">
			<small>
				© 2006-{{ date().format('Y') }} C.S.R. Delft
			</small>

			<a
				class="link-secondary"
				href="/download/Privacyverklaring%20C.S.R.%20Delft%20-%20Extern%20-%2025-05-2018.pdf"
			>
				Privacyverklaring
			</a>

			{% if not app.debug and is_granted('ROLE_ADMIN') %}
				<small>
					<a
						href="{{ commitLink() }}"
						target="_blank"
						rel="noopener"
						class="not-external"
					>{{ commitHash() }}</a>
				</small>
			{% endif %}
		</div>
	</div>
</footer>
